# TwinLabs Alpha — copy to .env locally; never commit .env or actual credentials.
# Default example: self-contained memory mode.
# TWIN_STORAGE=memory
# For PostgreSQL/TimescaleDB, leave TWIN_STORAGE unset (including in the shell).
PGHOST=localhost
PGPORT=5432
PGDATABASE=digital_twin_18
# PGUSER=your_local_database_user
# PGPASSWORD=your_local_database_password
# DATABASE_URL=postgresql://...  # if set, overrides PG* settings
SERVER_PORT=3001

# Database schema: digital_twin requires npm run db:setup:v3 + installed TimescaleDB.
# For legacy PostgreSQL use twin18 and npm run db:setup.
TWIN_DB_SCHEMA=digital_twin

# Local Ollama/Qwen; optional for core simulation and rule-based alerts.
OLLAMA_URL=http://127.0.0.1:11434
LLM_BRIDGE_URL=http://127.0.0.1:8011
# LLM_HISTORY_DB=/absolute/path/to/local/normal-history.sqlite

# Hybrid Python generator; no downloaded dataset is needed.
SIMULATOR_MODE=hybrid
SIM_INTERVAL_SECONDS=5
SIM_STEP_SECONDS=5
SIM_CLOCK_DOMAIN=same_host
# SIM_START_TIME=2026-11-15T08:00:00+08:00
# SIM_SEED=1234
# SIM_FAULT_MODE=normal
# SIM_CALENDAR_FILE=/absolute/path/to/company-calendar.json
# SIMULATOR_AUTOSTART=false
# Accelerated demo: SIM_STEP_SECONDS=300 and SIM_INTERVAL_SECONDS=2

# Optional dataset replay (not hybrid generation)
# SIMULATOR_MODE=replay
# DATASET_PATH=/absolute/path/to/dataset.zip
# DATASET_SPLIT=fault_weather_2026_q1

# Administrator login uses digital_twin.users and digital_twin.roles.\n# No ADMIN_USERNAME or ADMIN_PASSWORD_HASH belongs in .env.\n# Run npm run admin:setup to create the database account if it is not present.\n
# Optional REAL invitation email sending via Resend (host laptop only).
# Create a Resend API key and verify the sender domain first.
# RESEND_API_KEY=re_your_private_key
# INVITE_FROM_EMAIL=TwinLabs <invites@your-verified-domain.example>
# APP_PUBLIC_URL=http://172.20.10.7:3001
# APP_PUBLIC_URL must be reachable by invitees; hotspot IP changes on reconnect.
# Never commit real keys, user emails or passwords.

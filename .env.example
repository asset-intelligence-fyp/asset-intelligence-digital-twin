# Example settings for 18-point whole-building PostgreSQL demo. Keep your real .env.
PGHOST=localhost
PGPORT=5432
PGDATABASE=digital_twin_18
SERVER_PORT=3001
PGSSL=false
# Local AI demonstration settings
# Legacy Level 5 AI flag; not evidence that whole-building AI is integrated:
# AI_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434

# Active 18-point Qwen3 room assistant (started by npm run dev)
OLLAMA_URL=http://127.0.0.1:11434
LLM_BRIDGE_URL=http://127.0.0.1:8011
# Optional separate read-only, synthetic normal-history SQLite reference
# LLM_HISTORY_DB=/absolute/path/to/digital_twin.sqlite

# Exact supplied-dataset replay: ZIP or extracted directory, never inside public/.
# DATASET_PATH=/Users/emily/Downloads/generated(1).zip
DATASET_SPLIT=fault_weather_2026_q1
SIM_INTERVAL_SECONDS=2
# Optional inclusive start / exclusive end in original dataset time:
# DATASET_START=2026-01-01T08:00:00+08:00
# DATASET_END=2026-01-02T00:00:00+08:00
# SIM_TICKS=40
# Use same_host only when Python and API share the same computer clock.
SIM_CLOCK_DOMAIN=same_host
# SIMULATOR_AUTOSTART=false

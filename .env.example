# Example settings for 18-point whole-building PostgreSQL demo. Keep your real .env.
PGHOST=localhost
PGPORT=5432
PGDATABASE=digital_twin_18
SERVER_PORT=3001
PGSSL=false
# Local AI demonstration settings
# Legacy Level 5 AI flag; not evidence that whole-building AI is integrated:
# AI_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434

# Active 18-point Qwen3 room assistant (started by npm run dev)
OLLAMA_URL=http://127.0.0.1:11434
LLM_BRIDGE_URL=http://127.0.0.1:8011
# Optional separate read-only, synthetic normal-history SQLite reference
# LLM_HISTORY_DB=/absolute/path/to/digital_twin.sqlite

# Optional replay mode only: ZIP or extracted directory, never inside public/.
# DATASET_PATH=/Users/emily/Downloads/generated(1).zip
DATASET_SPLIT=fault_weather_2026_q1
SIM_INTERVAL_SECONDS=5
# Optional inclusive start / exclusive end in original dataset time:
# DATASET_START=2026-01-01T08:00:00+08:00
# DATASET_END=2026-01-02T00:00:00+08:00
# SIM_TICKS=40
# Use same_host only when Python and API share the same computer clock.
SIM_CLOCK_DOMAIN=same_host
# SIMULATOR_AUTOSTART=false

# Hybrid is the default: generates NEW readings from the fitted profile, no ZIP needed.
SIMULATOR_MODE=hybrid
# For near-live time, use equal steps and delivery intervals:
SIM_STEP_SECONDS=5
# Set SIM_INTERVAL_SECONDS=5 above for a five-second wall-clock release interval.
# For accelerated demonstration, use SIM_STEP_SECONDS=300 with SIM_INTERVAL_SECONDS=2.
# SIM_START_TIME=2026-11-05T08:00:00+08:00
# SIM_SEED=1234
# SIM_CALENDAR_FILE=/absolute/path/to/company-calendar.json
# SIM_FAULT_MODE=normal
# Explicit legacy replay: SIMULATOR_MODE=replay, then configure DATASET_PATH above.

# Amanda administrator viewer (configure locally only; do not commit secrets)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=scrypt:<32-hex-salt>:<128-hex-hash>
# Generate a hash with: node scripts/generate-admin-hash.mjs

# Optional unified Database Schema v3 (run npm run db:setup:v3 first).
# Default stays twin18 for compatibility; do not enable until v3 schema verified.
# TWIN_DB_SCHEMA=digital_twin
